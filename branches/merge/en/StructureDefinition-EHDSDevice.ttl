           fhir:url [ fhir:v "actor"^^xsd:anyURI ] ;
           fhir:value [
             a fhir:canonical ;
             fhir:v "https://ehds.eu/specifications/fhir/actor-basic"^^xsd:anyURI ;
             fhir:link <https://ehds.eu/specifications/fhir/actor-basic>
           ]
         ] ) ;
         fhir:url [ fhir:v "http://hl7.org/fhir/StructureDefinition/obligation"^^xsd:anyURI ]
       ] ) ;
       fhir:path [ fhir:v "EHDSDevice.note" ] ;
       fhir:short [ fhir:v "Device note and/or comment." ] ;
       fhir:definition [ fhir:v "Device note and/or comment." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [ fhir:v "string"^^xsd:anyURI ]
       ] )
     ] )
  ] . # 

