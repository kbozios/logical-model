       fhir:short [ fhir:v "Specimen model" ] ;
       fhir:definition [ fhir:v "EHDSSpecimen means a structured set of data elements describing a sample collected." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "*" ] ;
       fhir:base [
         fhir:path [ fhir:v "Base" ] ;
