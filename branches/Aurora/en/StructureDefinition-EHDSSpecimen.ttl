       ] )
     ] [
       fhir:id [ fhir:v "EHDSSpecimen.identifier" ] ;
       fhir:extension ( [
         fhir:extension ( [
           fhir:url [ fhir:v "code"^^xsd:anyURI ] ;
           fhir:value [
             a fhir:code ;
             fhir:v "SHALL:process"
           ]
